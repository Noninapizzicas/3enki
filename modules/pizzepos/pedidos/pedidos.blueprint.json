        "orden": 1,
        "ops": [
          "create",
          "send-kitchen",
          "complete",
          "cancel",
          "confirmar-recogida"
        ],
        "descripcion": "Declara y gobierna la venta (abrir, enviar cocina, completar, cancelar, recogida)"
      },
      {
        "nombre": "utilizacion",
        "orden": 2,
        "ops": [
          "add-item",
          "update-item",
          "delete-item",
          "crear-tienda"
        ],
        "descripcion": "Opera al elegir (añadir/quitar/editar items del pedido)"
      },
      {
        "nombre": "consulta",
        "orden": 3,
        "ops": [
          "list",
          "get",
          "total",
          "health"
        ],
        "descripcion": "Ver estado y totales"
      }
    ],
    "dependencias": {
      "get": [
        {
