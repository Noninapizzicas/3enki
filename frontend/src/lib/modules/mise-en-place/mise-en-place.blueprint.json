{
  "schema": "blueprint-interfaz-v2",
  "id": "mise-en-place",
  "version": "blueprint-2.0.0",
  "moduleId": "mise-en-place",
  "actor": "jefe",
  "titulo": "Planificacion previa al servicio: escalado de recetas a porciones objetivo, planes de produccion (que recetas en que franja con cuantas porciones), consolidacion de listas de compra agregando ingredientes a lo largo de un horizonte. Eventos canonicos con prefix 'produccion.*' (decision del sub-contrato). Modulo del subsistema-recetario (ver arquitectura/decisiones/_contratos/subsistema-recetario.contract.json).",
  "eventos_publicados": [
    "produccion.escalado.calculado",
    "produccion.plan.publicado",
    "produccion.compra.calculada",
    "produccion.retroplanning.calculado",
    "produccion.tandas.agrupadas",
    "produccion.plan.estado.avanzado"
  ],
  "eventos_que_escucho": [
    "project.activated",
    "project.get.response",
    "fs.read.response",
    "fs.write.response",
    "produccion.escalado.calcular",
    "produccion.plan.publicar",
    "produccion.compra.calcular",
    "produccion.plan.obtener",
    "produccion.planes.listar",
    "masa.reglas.leer.response",
    "masa.gramaje.calcular.response",
    "masa.rendimiento.calcular.response",
    "produccion.retroplanning.calcular",
    "produccion.plan.aprobar",
    "produccion.plan.ejecutar",
    "produccion.plan.cerrar"
  ],
  "transporte": {
    "rpc": [
      "mise-en-place.escalado.calcular.request -> .response",
      "mise-en-place.plan.publicar.request -> .response",
      "mise-en-place.compra.calcular.request -> .response",
      "mise-en-place.plan.obtener.request -> .response",
      "mise-en-place.planes.listar.request -> .response",
      "mise-en-place.retroplanning.calcular.request -> .response",
      "mise-en-place.plan.aprobar.request -> .response",
      "mise-en-place.plan.ejecutar.request -> .response",
      "mise-en-place.plan.cerrar.request -> .response",
      "mise-en-place.agrupar_tandas.request -> .response"
    ],
    "salida": [
      "produccion.escalado.calculado",
      "produccion.plan.publicado",
      "produccion.compra.calculada",
      "produccion.retroplanning.calculado",
      "produccion.tandas.agrupadas",
      "produccion.plan.estado.avanzado"
    ]
  },
  "ui": {
    "roles": {
      "escalado.calcular": "jefe",
      "plan.publicar": "jefe",
      "compra.calcular": "jefe",
      "plan.obtener": "neutro",
      "planes.listar": "neutro",
      "retroplanning.calcular": "jefe",
      "plan.aprobar": "jefe",
      "plan.ejecutar": "jefe",
      "plan.cerrar": "jefe",
      "agrupar_tandas": "jefe"
    },
    "ops": {
      "escalado.calcular": {
        "titulo": "Escalado.calcular",
        "descripcion": "Calcular el escalado lineal de una receta a nuevas porciones. Multiplica cada cantidad por factor = porciones_destino/porciones_origen. NO modifica la receta canonica.",
        "args": [
          {
            "nombre": "receta_id",
            "tipo": "ref",
            "required": true,
            "descripcion": "ID de la receta a escalar.",
            "ref": "recetas.listar",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un receta"
          },
          {
            "nombre": "porciones_origen",
            "tipo": "number",
            "required": true,
            "descripcion": "Porciones originales de la receta."
          },
          {
            "nombre": "porciones_destino",
            "tipo": "number",
            "required": true,
            "descripcion": "Porciones objetivo."
          },
          {
            "nombre": "ingredientes",
            "tipo": "json",
            "required": true,
            "descripcion": "Ingredientes de la receta original (para las porciones_origen)."
          },
          {
            "nombre": "user_id",
            "tipo": "ref",
            "required": false,
            "descripcion": "Opcional.",
            "ref": "user.listar",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un user"
          }
        ]
      },
      "plan.publicar": {
        "titulo": "Plan.publicar",
        "descripcion": "Publicar un plan de produccion: lineas con receta_id, porciones y franja para un horizonte temporal.",
        "args": [
          {
            "nombre": "plan_id",
            "tipo": "ref",
            "required": false,
            "descripcion": "ID opcional. Si se omite, se genera 'plan_xxx'.",
            "ref": "plan.listar",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un plan"
          },
          {
            "nombre": "horizonte_desde",
            "tipo": "string",
            "required": true,
            "descripcion": "ISO 8601 date-time inicio del horizonte."
          },
          {
            "nombre": "horizonte_hasta",
            "tipo": "string",
            "required": true,
            "descripcion": "ISO 8601 date-time fin del horizonte."
          },
          {
            "nombre": "lineas",
            "tipo": "json",
            "required": true
          },
          {
            "nombre": "user_id",
            "tipo": "ref",
            "required": false,
            "descripcion": "Opcional.",
            "ref": "user.listar",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un user"
          }
        ]
      },
      "compra.calcular": {
        "titulo": "Compra.calcular",
        "descripcion": "Consolidar lista de compra agregando ingredientes a lo largo de un conjunto de recetas. El caller pasa cada receta con sus ingredientes ya escalados para las porciones objetivo. Agrega por (ingredient",
        "args": [
          {
            "nombre": "horizonte",
            "tipo": "json",
            "required": true
          },
          {
            "nombre": "recetas",
            "tipo": "json",
            "required": true
          },
          {
            "nombre": "user_id",
            "tipo": "ref",
            "required": false,
            "descripcion": "Opcional.",
            "ref": "user.listar",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un user"
          }
        ]
      },
      "plan.obtener": {
        "titulo": "Plan.obtener",
        "descripcion": "Obtener un plan de produccion por id.",
        "args": [
          {
            "nombre": "plan_id",
            "tipo": "ref",
            "required": true,
            "descripcion": "ID del plan.",
            "ref": "plan.listar",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un plan"
          }
        ]
      },
      "planes.listar": {
        "titulo": "Planes.listar",
        "descripcion": "Listar planes del proyecto."
      },
      "retroplanning.calcular": {
        "titulo": "Retroplanning.calcular",
        "descripcion": "Retroplanning de produccion: dada la senal de demanda (fecha_servicio + franja + recetas con porciones) devuelve la ventana de produccion de cada receta (desde/hasta/recomendada) restando la ventana d",
        "args": [
          {
            "nombre": "fecha_servicio",
            "tipo": "string",
            "required": true,
            "descripcion": "Cuando se sirve: 'YYYY-MM-DD' (la franja fija la hora) o ISO 8601 completo."
          },
          {
            "nombre": "franja",
            "tipo": "select",
            "required": true,
            "enum": [
              "desayuno",
              "comida",
              "merienda",
              "cena",
              "all_day"
            ]
          },
          {
            "nombre": "lineas",
            "tipo": "json",
            "required": true
          },
          {
            "nombre": "user_id",
            "tipo": "ref",
            "required": false,
            "descripcion": "Opcional.",
            "ref": "user.listar",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un user"
          }
        ]
      },
      "plan.aprobar": {
        "titulo": "Plan.aprobar",
        "descripcion": "Aprobar un plan de produccion: transicion propuesto -> aprobado. Solo el dueno (quien invoca) aprueba. Rechaza CONFLICT_STATE si el plan tiene decision_pendiente sin confirmar.",
        "args": [
          {
            "nombre": "plan_id",
            "tipo": "ref",
            "required": true,
            "descripcion": "ID del plan a aprobar.",
            "ref": "plan.listar",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un plan"
          },
          {
            "nombre": "user_id",
            "tipo": "ref",
            "required": false,
            "descripcion": "Opcional.",
            "ref": "user.listar",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un user"
          }
        ]
      },
      "plan.ejecutar": {
        "titulo": "Plan.ejecutar",
        "descripcion": "Marcar un plan aprobado como en ejecucion (hoy: se produce). Transicion aprobado -> en_ejecucion.",
        "args": [
          {
            "nombre": "plan_id",
            "tipo": "ref",
            "required": true,
            "descripcion": "ID del plan a ejecutar.",
            "ref": "plan.listar",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un plan"
          },
          {
            "nombre": "user_id",
            "tipo": "ref",
            "required": false,
            "descripcion": "Opcional.",
            "ref": "user.listar",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un user"
          }
        ]
      },
      "plan.cerrar": {
        "titulo": "Plan.cerrar",
        "descripcion": "Cerrar un plan en ejecucion (producido; las tandas siguen vivas en lotes). Transicion en_ejecucion -> cerrado.",
        "args": [
          {
            "nombre": "plan_id",
            "tipo": "ref",
            "required": true,
            "descripcion": "ID del plan a cerrar.",
            "ref": "plan.listar",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un plan"
          },
          {
            "nombre": "user_id",
            "tipo": "ref",
            "required": false,
            "descripcion": "Opcional.",
            "ref": "user.listar",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un user"
          }
        ]
      },
      "agrupar_tandas": {
        "titulo": "Agrupar Tandas",
        "descripcion": "Agrupar lineas de demanda en tandas de masa: pide a masa el gramaje por pieza y el rendimiento por tanda (masa.gramaje.calcular / masa.rendimiento.calcular); empaqueta por franja con capacidad en bola",
        "args": [
          {
            "nombre": "lineas",
            "tipo": "json",
            "required": true
          },
          {
            "nombre": "formato",
            "tipo": "string",
            "required": false,
            "descripcion": "Formato de masa (ej: '33cm'). Default config."
          },
          {
            "nombre": "tamano_tanda_kg",
            "tipo": "number",
            "required": false,
            "descripcion": "Tamano de tanda en kg. Default config."
          },
          {
            "nombre": "user_id",
            "tipo": "ref",
            "required": false,
            "descripcion": "Opcional.",
            "ref": "user.listar",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un user"
          }
        ]
      }
    },
    "datos": {
      "op": "planes.listar",
      "titulo": "Planes.listar",
      "refresh_on": [
        "produccion.escalado.calculado",
        "produccion.plan.publicado",
        "produccion.compra.calculada",
        "produccion.retroplanning.calculado",
        "produccion.tandas.agrupadas",
        "produccion.plan.estado.avanzado"
      ]
    },
    "estados": [
      {
        "nombre": "borrador",
        "terminal": false,
        "color": "gray",
        "icono": "📝"
      },
      {
        "nombre": "escalado_calculado",
        "terminal": false,
        "color": "gray",
        "icono": "⚪"
      },
      {
        "nombre": "plan_publicado",
        "terminal": false,
        "color": "gray",
        "icono": "⚪"
      },
      {
        "nombre": "compra_calculada",
        "terminal": false,
        "color": "gray",
        "icono": "⚪"
      },
      {
        "nombre": "retroplanning_calculado",
        "terminal": false,
        "color": "gray",
        "icono": "⚪"
      },
      {
        "nombre": "tandas_agrupadas",
        "terminal": false,
        "color": "gray",
        "icono": "⚪"
      },
      {
        "nombre": "plan_estado_avanzado",
        "terminal": false,
        "color": "gray",
        "icono": "⚪"
      }
    ],
    "flujo": [
      {
        "nombre": "jefe",
        "orden": 1,
        "ops": [
          "plan.publicar",
          "escalado.calcular",
          "compra.calcular",
          "retroplanning.calcular",
          "agrupar_tandas",
          "plan.aprobar",
          "plan.ejecutar",
          "plan.cerrar"
        ],
        "descripcion": "Planificacion y supervision del jefe: crear planes, calcular escalados/compras/retroplanning, aprobar/ejecutar/cerrar planes"
      },
      {
        "nombre": "consulta",
        "orden": 3,
        "ops": [
          "plan.obtener",
          "planes.listar"
        ],
        "descripcion": "Ver y buscar planes de produccion"
      }
    ],
    "guardas": {
      "plan.aprobar": {
        "sensible_estado": true
      },
      "plan.ejecutar": {
        "sensible_estado": true
      },
      "plan.cerrar": {
        "sensible_estado": true
      }
    }
  }
}
