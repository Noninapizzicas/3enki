{
  "name": "hermes-relay",
  "version": "1.0.0",
  "description": "Pipe puro: chat.message.saved → Hermes /v1/chat/completions → ai.chat.response. Reemplaza prompt-builder + ai-gateway en la cadena conversacional.",
  "dependencies": ["database-manager"],
  "subscribes": [
    { "event": "chat.message.saved", "handler": "onMessageSaved" },
    { "event": "db.query.response", "handler": "onDbQueryResponse" }
  ],
  "publishes": ["ai.chat.response", "ai.chat.failed"],
  "provides": { "apis": [], "hooks": [] },
  "config": {
    "hermes_url": "http://localhost:8642/v1/chat/completions",
    "hermes_model": "hermes",
    "context_window": 40,
    "request_timeout_ms": 300000
  }
}
