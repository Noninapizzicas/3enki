{
  "schema": "blueprint-interfaz-v2",
  "id": "cupula_stl",
  "version": "blueprint-2.0.0",
  "moduleId": "cupula_stl",
  "titulo": "Cúpula del modelo 3D universal: STL/3MF una vez por pieza, sirve para cualquier máquina.",
  "eventos_que_escucho": [
    "cupula_stl.registrar.request",
    "cupula_stl.obtener.request",
    "cupula_stl.listar.request",
    "project.activated"
  ],
  "transporte": {
    "rpc": [
      "cupula_stl.registrar.request -> .response",
      "cupula_stl.obtener.request -> .response",
      "cupula_stl.listar.request -> .response"
    ]
  },
  "ui": {
    "ops": {
      "registrar": {
        "titulo": "Registrar",
        "args": [
          {
            "nombre": "nombre",
            "tipo": "string",
            "required": true,
            "descripcion": "Nombre del modelo"
          },
          {
            "nombre": "archivo",
            "tipo": "string",
            "required": true,
            "descripcion": "Ruta o contenido del archivo STL/3MF"
          },
          {
            "nombre": "formato",
            "tipo": "select",
            "required": false,
            "enum": [
              "stl",
              "3mf"
            ],
            "descripcion": "Formato (por defecto stl)"
          },
          {
            "nombre": "parametros",
            "tipo": "json",
            "required": false,
            "descripcion": "Parámetros del modelo (opcional)"
          },
          {
            "nombre": "origen",
            "tipo": "string",
            "required": false,
            "descripcion": "Origen (ej: printables)"
          },
          {
            "nombre": "ref",
            "tipo": "string",
            "required": false,
            "descripcion": "Referencia en el origen"
          }
        ]
      },
      "obtener": {
        "titulo": "Obtener",
        "args": [
          {
            "nombre": "id",
            "tipo": "string",
            "required": true,
            "descripcion": "ID del STL"
          }
        ]
      },
      "listar": {
        "titulo": "Listar",
        "args": [
          {
            "nombre": "nombre",
            "tipo": "string",
            "required": false,
            "descripcion": "Filtrar por nombre (opcional)"
          }
        ]
      }
    },
    "datos": {
      "op": "listar",
      "titulo": "Listar"
    },
    "flujo": [
      {
        "nombre": "jefe",
        "orden": 0,
        "ops": [
          "registrar"
        ],
        "descripcion": "Registrar y consultar STL"
      },
      {
        "nombre": "utilidad",
        "orden": 5,
        "ops": [
          "obtener",
          "listar"
        ],
        "descripcion": "Herramientas y consultas"
      }
    ],
    "roles": {
      "registrar": "jefe",
      "obtener": "neutro",
      "listar": "neutro"
    }
  }
}
