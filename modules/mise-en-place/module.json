{
  "name": "mise-en-place",
  "version": "1.0.0",
  "description": "Planificacion previa al servicio: escalado de recetas a porciones objetivo, planes de produccion (que recetas en que franja con cuantas porciones), consolidacion de listas de compra agregando ingredientes a lo largo de un horizonte. Eventos canonicos con prefix 'produccion.*' (decision del sub-contrato). Modulo del subsistema-recetario (ver arquitectura/decisiones/_contratos/subsistema-recetario.contract.json).",
  "author": "Enki",
  "language": "es",
  "tier": "tier_4_dominio",
  "events": {
    "publishes": [
      {
        "event": "produccion.escalado.calculado",
        "description": "Se calculo el escalado de una receta a nuevas porciones.",
        "response_schema_ref": "arquitectura/decisiones/_schemas/subsistema-recetario/produccion.escalado.calculado.schema.json"
      },
      {
        "event": "produccion.plan.publicado",
        "description": "El jefe publico un plan de produccion semanal/diario.",
        "response_schema_ref": "arquitectura/decisiones/_schemas/subsistema-recetario/produccion.plan.publicado.schema.json"
      },
      {
        "event": "produccion.compra.calculada",
        "description": "Se consolido la lista de compra de un horizonte.",
        "response_schema_ref": "arquitectura/decisiones/_schemas/subsistema-recetario/produccion.compra.calculada.schema.json"
      },
      {
        "event": "produccion.retroplanning.calculado",
        "description": "Se calculo la ventana de produccion retroplanning para una senal de demanda."
      },
      {
        "event": "produccion.tandas.agrupadas",
        "description": "Se agruparon lineas de demanda en tandas de masa para produccion."
      },
      {
        "event": "produccion.plan.estado.avanzado",
        "description": "El plan de produccion avanzo de estado (propuesto -> aprobado -> en_ejecucion -> cerrado)."
      }
    ],
    "subscribes": [
      {
        "event": "project.activated",
        "handler": "onProjectActivated",
        "description": "Cachea base_path del proyecto activado."
      },
      {
        "event": "project.get.response",
        "handler": "onProjectGetResponse",
        "description": "Resuelve project.get pendiente por request_id."
      },
      {
        "event": "fs.read.response",
        "handler": "onFsReadResponse",
        "description": "Resuelve lectura pendiente por request_id."
      },
      {
        "event": "fs.write.response",
        "handler": "onFsWriteResponse",
        "description": "Resuelve escritura pendiente por request_id."
      },
      {
        "event": "produccion.escalado.calcular",
        "handler": "onCalcularEscalado",
        "description": "Tool LLM: calcular escalado de receta."
      },
      {
        "event": "produccion.plan.publicar",
        "handler": "onPublicarPlan",
        "description": "Tool LLM: publicar plan de produccion."
      },
      {
        "event": "produccion.compra.calcular",
        "handler": "onCalcularCompra",
        "description": "Tool LLM: consolidar lista de compra."
      },
      {
        "event": "produccion.plan.obtener",
        "handler": "onObtenerPlan",
        "description": "Tool LLM: leer plan por id."
      },
      {
        "event": "produccion.planes.listar",
        "handler": "onListarPlanes",
        "description": "Tool LLM: listar planes del proyecto."
      },
      {
        "event": "masa.reglas.leer.response",
        "handler": "onMasaReglasResponse",
        "description": "Resuelve masa.reglas pendiente por request_id."
      },
      {
        "event": "masa.gramaje.calcular.response",
        "handler": "onMasaGramajeResponse",
        "description": "Resuelve masa.gramaje pendiente por request_id (A3)."
      },
      {
        "event": "masa.rendimiento.calcular.response",
        "handler": "onMasaRendimientoResponse",
        "description": "Resuelve masa.rendimiento pendiente por request_id (A3)."
      },
      {
        "event": "produccion.retroplanning.calcular",
        "handler": "onCalcularRetroplanning",
        "description": "Tool LLM: retroplanning de produccion (ventana de produccion para servir X)."
      },
      {
        "event": "produccion.plan.aprobar",
        "handler": "onAprobarPlan",
        "description": "Tool LLM: aprobar plan (propuesto -> aprobado)."
      },
      {
        "event": "produccion.plan.ejecutar",
        "handler": "onEjecutarPlan",
        "description": "Tool LLM: marcar plan en ejecucion (aprobado -> en_ejecucion)."
      },
      {
        "event": "produccion.plan.cerrar",
        "handler": "onCerrarPlan",
        "description": "Tool LLM: cerrar plan (en_ejecucion -> cerrado)."
      }
    ]
  },
  "apis": [],
  "tools": [
    {
      "name": "produccion.escalado.calcular",
      "description": "Calcular el escalado lineal de una receta a nuevas porciones. Multiplica cada cantidad por factor = porciones_destino/porciones_origen. NO modifica la receta canonica.",
      "handler": "onCalcularEscalado",
      "parameters": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "ID del proyecto activo."
          },
          "receta_id": {
            "type": "string",
            "description": "ID de la receta a escalar."
          },
          "porciones_origen": {
            "type": "integer",
            "minimum": 1,
            "description": "Porciones originales de la receta."
          },
          "porciones_destino": {
            "type": "integer",
            "minimum": 1,
            "description": "Porciones objetivo."
          },
          "ingredientes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "nombre": {
                  "type": "string"
                },
                "cantidad": {
                  "type": "number",
                  "minimum": 0
                },
                "unidad": {
                  "type": "string"
                }
              },
              "required": [
                "nombre",
                "cantidad",
                "unidad"
              ]
            },
            "description": "Ingredientes de la receta original (para las porciones_origen)."
          },
          "user_id": {
            "type": "string",
            "description": "Opcional."
          }
        },
        "required": [
          "project_id",
          "receta_id",
          "porciones_origen",
          "porciones_destino",
          "ingredientes"
        ]
      },
      "errores_conocidos": [
        "INVALID_INPUT",
        "UPSTREAM_TIMEOUT",
        "UPSTREAM_UNREACHABLE"
      ]
    },
    {
      "name": "produccion.plan.publicar",
      "description": "Publicar un plan de produccion: lineas con receta_id, porciones y franja para un horizonte temporal.",
      "handler": "onPublicarPlan",
      "parameters": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "ID del proyecto activo."
          },
          "plan_id": {
            "type": "string",
            "description": "ID opcional. Si se omite, se genera 'plan_xxx'."
          },
          "horizonte_desde": {
            "type": "string",
            "description": "ISO 8601 date-time inicio del horizonte."
          },
          "horizonte_hasta": {
            "type": "string",
            "description": "ISO 8601 date-time fin del horizonte."
          },
          "lineas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "receta_id": {
                  "type": "string"
                },
                "porciones": {
                  "type": "integer",
                  "minimum": 1
                },
                "franja": {
                  "type": "string",
                  "enum": [
                    "desayuno",
                    "comida",
                    "merienda",
                    "cena",
                    "all_day"
                  ]
                },
                "dia": {
                  "type": "string",
                  "description": "ISO 8601 date opcional."
                }
              },
              "required": [
                "receta_id",
                "porciones",
                "franja"
              ]
            }
          },
          "user_id": {
            "type": "string",
            "description": "Opcional."
          }
        },
        "required": [
          "project_id",
          "horizonte_desde",
          "horizonte_hasta",
          "lineas"
        ]
      },
      "errores_conocidos": [
        "INVALID_INPUT",
        "UPSTREAM_TIMEOUT"
      ]
    },
    {
      "name": "produccion.compra.calcular",
      "description": "Consolidar lista de compra agregando ingredientes a lo largo de un conjunto de recetas. El caller pasa cada receta con sus ingredientes ya escalados para las porciones objetivo. Agrega por (ingrediente, unidad) y aplica merma_pct opcional.",
      "handler": "onCalcularCompra",
      "parameters": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "ID del proyecto activo."
          },
          "horizonte": {
            "type": "object",
            "properties": {
              "tipo": {
                "type": "string",
                "enum": [
                  "servicio",
                  "dia",
                  "semana",
                  "evento",
                  "personalizado"
                ]
              },
              "desde": {
                "type": "string"
              },
              "hasta": {
                "type": "string"
              },
              "etiqueta": {
                "type": "string"
              }
            },
            "required": [
              "tipo"
            ]
          },
          "recetas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "receta_id": {
                  "type": "string"
                },
                "porciones": {
                  "type": "integer",
                  "minimum": 1
                },
                "ingredientes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "nombre": {
                        "type": "string"
                      },
                      "cantidad": {
                        "type": "number",
                        "minimum": 0
                      },
                      "unidad": {
                        "type": "string"
                      },
                      "merma_pct": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      }
                    },
                    "required": [
                      "nombre",
                      "cantidad",
                      "unidad"
                    ]
                  }
                }
              },
              "required": [
                "receta_id",
                "porciones",
                "ingredientes"
              ]
            }
          },
          "user_id": {
            "type": "string",
            "description": "Opcional."
          }
        },
        "required": [
          "project_id",
          "horizonte",
          "recetas"
        ]
      },
      "errores_conocidos": [
        "INVALID_INPUT",
        "UPSTREAM_TIMEOUT"
      ]
    },
    {
      "name": "produccion.plan.obtener",
      "description": "Obtener un plan de produccion por id.",
      "handler": "onObtenerPlan",
      "parameters": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "ID del proyecto activo."
          },
          "plan_id": {
            "type": "string",
            "description": "ID del plan."
          }
        },
        "required": [
          "project_id",
          "plan_id"
        ]
      },
      "errores_conocidos": [
        "INVALID_INPUT",
        "RESOURCE_NOT_FOUND"
      ]
    },
    {
      "name": "produccion.planes.listar",
      "description": "Listar planes del proyecto.",
      "handler": "onListarPlanes",
      "parameters": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "ID del proyecto activo."
          }
        },
        "required": [
          "project_id"
        ]
      },
      "errores_conocidos": [
        "INVALID_INPUT",
        "UPSTREAM_TIMEOUT"
      ]
    }
    ,
    {
      "name": "produccion.retroplanning.calcular",
      "description": "Retroplanning de produccion: dada la senal de demanda (fecha_servicio + franja + recetas con porciones) devuelve la ventana de produccion de cada receta (desde/hasta/recomendada) restando la ventana de maduracion que declara masa. Conversor puro: no persiste.",
      "handler": "onCalcularRetroplanning",
      "parameters": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "ID del proyecto activo."
          },
          "fecha_servicio": {
            "type": "string",
            "description": "Cuando se sirve: 'YYYY-MM-DD' (la franja fija la hora) o ISO 8601 completo."
          },
          "franja": {
            "type": "string",
            "enum": [
              "desayuno",
              "comida",
              "merienda",
              "cena",
              "all_day"
            ]
          },
          "lineas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "receta_id": {
                  "type": "string"
                },
                "porciones": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "receta_id",
                "porciones"
              ]
            }
          },
          "user_id": {
            "type": "string",
            "description": "Opcional."
          }
        },
        "required": [
          "project_id",
          "fecha_servicio",
          "franja",
          "lineas"
        ]
      },
      "errores_conocidos": [
        "INVALID_INPUT",
        "UPSTREAM_TIMEOUT"
      ]
    },
    {
      "name": "produccion.plan.aprobar",
      "description": "Aprobar un plan de produccion: transicion propuesto -> aprobado. Solo el dueno (quien invoca) aprueba. Rechaza CONFLICT_STATE si el plan tiene decision_pendiente sin confirmar.",
      "handler": "onAprobarPlan",
      "parameters": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "ID del proyecto activo."
          },
          "plan_id": {
            "type": "string",
            "description": "ID del plan a aprobar."
          },
          "user_id": {
            "type": "string",
            "description": "Opcional."
          }
        },
        "required": [
          "project_id",
          "plan_id"
        ]
      },
      "errores_conocidos": [
        "INVALID_INPUT",
        "RESOURCE_NOT_FOUND",
        "CONFLICT_STATE"
      ]
    },
    {
      "name": "produccion.plan.ejecutar",
      "description": "Marcar un plan aprobado como en ejecucion (hoy: se produce). Transicion aprobado -> en_ejecucion.",
      "handler": "onEjecutarPlan",
      "parameters": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "ID del proyecto activo."
          },
          "plan_id": {
            "type": "string",
            "description": "ID del plan a ejecutar."
          },
          "user_id": {
            "type": "string",
            "description": "Opcional."
          }
        },
        "required": [
          "project_id",
          "plan_id"
        ]
      },
      "errores_conocidos": [
        "INVALID_INPUT",
        "RESOURCE_NOT_FOUND",
        "CONFLICT_STATE"
      ]
    },
    {
      "name": "produccion.plan.cerrar",
      "description": "Cerrar un plan en ejecucion (producido; las tandas siguen vivas en lotes). Transicion en_ejecucion -> cerrado.",
      "handler": "onCerrarPlan",
      "parameters": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "ID del proyecto activo."
          },
          "plan_id": {
            "type": "string",
            "description": "ID del plan a cerrar."
          },
          "user_id": {
            "type": "string",
            "description": "Opcional."
          }
        },
        "required": [
          "project_id",
          "plan_id"
        ]
      },
      "errores_conocidos": [
        "INVALID_INPUT",
        "RESOURCE_NOT_FOUND",
        "CONFLICT_STATE"
      ]
    },
    {
      "name": "produccion.agrupar_tandas",
      "description": "Agrupar lineas de demanda en tandas de masa: pide a masa el gramaje por pieza y el rendimiento por tanda (masa.gramaje.calcular / masa.rendimiento.calcular); empaqueta por franja con capacidad en bolas. Conversor puro: no persiste. Si masa no responde usa defaults de config y lo declara (fuente).",
      "handler": "onAgruparTandas",
      "parameters": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "ID del proyecto activo."
          },
          "lineas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "receta_id": {
                  "type": "string"
                },
                "porciones": {
                  "type": "integer",
                  "minimum": 1
                },
                "franja": {
                  "type": "string",
                  "enum": [
                    "desayuno",
                    "comida",
                    "merienda",
                    "cena",
                    "all_day"
                  ],
                  "description": "Opcional: agrupa lineas de la misma franja en la misma tanda si caben."
                }
              },
              "required": [
                "receta_id",
                "porciones"
              ]
            }
          },
          "formato": {
            "type": "string",
            "description": "Formato de masa (ej: '33cm'). Default config."
          },
          "tamano_tanda_kg": {
            "type": "number",
            "minimum": 0.1,
            "description": "Tamano de tanda en kg. Default config."
          },
          "user_id": {
            "type": "string",
            "description": "Opcional."
          }
        },
        "required": [
          "project_id",
          "lineas"
        ]
      },
      "errores_conocidos": [
        "INVALID_INPUT",
        "UPSTREAM_TIMEOUT"
      ]
    }
  ],
  "config": {
    "data_file_pattern": "data/projects/{slug}/mise-en-place.json",
    "persistence": {
      "scope": "project",
      "data_path": "mise-en-place",
      "pattern": "json-per-project"
    },
    "project_get_timeout_ms": 5000,
    "fs_request_timeout_ms": 5000,
    "retroplanning": {
      "ventana_default_min_horas": 24,
      "ventana_default_max_horas": 72,
      "masa_request_timeout_ms": 5000
    },
    "agrupacion": {
      "formato_default": "33cm",
      "gramaje_default_gramos": 280,
      "tanda_default_kg": 10,
      "masa_request_timeout_ms": 5000
    }
  },
  "observability": {
    "metrics": {
      "counters": [
        "mise-en-place.escalado.calculado.total",
        "mise-en-place.plan.publicado.total",
        "mise-en-place.compra.calculada.total",
        "mise-en-place.retroplanning.calculado.total",
        "mise-en-place.tandas.agrupadas.total",
        "mise-en-place.plan.estado.avanzado.total",
        "mise-en-place.errors",
        "mise-en-place.publish_error"
      ],
      "gauges": [
        "mise-en-place.planes.count"
      ],
      "timings": [
        "mise-en-place.compra.duration"
      ]
    }
  }
}
