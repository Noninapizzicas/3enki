{
  "schema": "blueprint-interfaz-v2",
  "id": "pedidos",
  "version": "blueprint-2.0.0",
  "moduleId": "pedidos",
  "actor": "jefe",
  "titulo": "Gestion completa de pedidos pizzepos. Dos tipos: tipo='pos' (flujo POS pizzeria con cuenta_id de cuentas-canales, items en pasos separados, enviado a cocina) y tipo='tienda' (vertical tienda PWA: plano sin cuenta_id, todos los items de una, cliente_nombre como ANCLA de recogida, estado pendiente_recogida). Recibe POS del comandero (bridge comandero.enviar_cocina) o UI handler. Recibe tienda via tool pedido.crear-tienda (auto-wire). Persiste en memoria con restauracion desde cuentas_activas.json al arrancar (delegacion a persistencia-comandero; aplica solo a tipo pos en v3.1.0). Cache de productos invalidada por catalogo.actualizado y producto.{creado,actualizado}.",
  "eventos_publicados": [
    "pedido.creado",
    "pedido.item_agregado",
    "pedido.item_actualizado",
    "pedido.item_eliminado",
    "pedido.enviado_cocina",
    "pedido.completado",
    "pedido.cancelado"
  ],
  "eventos_que_escucho": [
    "comandero.enviar_cocina",
    "variacion.validada",
    "variacion.rechazada",
    "cuenta.creada",
    "catalogo.actualizado",
    "producto.creado",
    "producto.actualizado",
    "caja.cerrada",
    "dia.iniciado",
    "pago.confirmado"
  ],
  "transporte": {
    "rpc": [
      "pedido.list.request -> .response",
      "pedido.get.request -> .response",
      "pedido.complete.request -> .response",
      "pedido.cancel.request -> .response",
      "pedido.total.request -> .response",
      "pedido.confirmar-recogida.request -> .response",
      "pedido.health.request -> .response"
    ],
    "salida": [
      "pedido.creado",
      "pedido.item_agregado",
      "pedido.item_actualizado",
      "pedido.item_eliminado",
      "pedido.enviado_cocina",
      "pedido.completado",
      "pedido.cancelado"
    ]
  },
  "ui": {
    "ops": {
      "list": {
        "titulo": "List",
        "descripcion": "Lista pedidos con filtros opcionales por cuenta_id y estado. Orden descendente por fecha de creacion.",
        "args": [
          {
            "nombre": "cuenta_id",
            "tipo": "ref",
            "required": false,
            "descripcion": "Filtro por cuenta.",
            "ref": "cuentas.listar",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un cuenta"
          },
          {
            "nombre": "estado",
            "tipo": "string",
            "required": false,
            "descripcion": "Filtro por estado del pedido."
          }
        ]
      },
      "get": {
        "titulo": "Get",
        "descripcion": "Obtiene un pedido por id.",
        "args": [
          {
            "nombre": "id",
            "tipo": "ref",
            "required": true,
            "descripcion": "Identificador del pedido.",
            "ref": "pedido.list",
            "ref_label": "id",
            "ref_value": "id",
            "placeholder": "selecciona pedido"
          }
        ]
      },
      "complete": {
        "titulo": "Complete",
        "descripcion": "Marca el pedido como completado (todos los items servidos). Emite pedido.completado.",
        "args": [
          {
            "nombre": "pedido_id",
            "tipo": "ref",
            "required": true,
            "descripcion": "Identificador del pedido.",
            "ref": "pedido.list",
            "ref_label": "id",
            "ref_value": "id",
            "placeholder": "selecciona un pedido"
          }
        ]
      },
      "cancel": {
        "titulo": "Cancel",
        "descripcion": "Cancela el pedido. Emite pedido.cancelado.",
        "args": [
          {
            "nombre": "pedido_id",
            "tipo": "ref",
            "required": true,
            "descripcion": "Identificador del pedido.",
            "ref": "pedido.list",
            "ref_label": "id",
            "ref_value": "id",
            "placeholder": "selecciona un pedido"
          },
          {
            "nombre": "motivo",
            "tipo": "string",
            "required": false,
            "descripcion": "Motivo de la cancelacion."
          }
        ]
      },
      "total": {
        "titulo": "Total",
        "descripcion": "Recalcula el subtotal/total de un pedido sumando precios de los items.",
        "args": [
          {
            "nombre": "pedido_id",
            "tipo": "ref",
            "required": true,
            "descripcion": "Identificador del pedido.",
            "ref": "pedido.list",
            "ref_label": "id",
            "ref_value": "id",
            "placeholder": "selecciona un pedido"
          }
        ]
      },
      "confirmar-recogida": {
        "titulo": "Confirmar-recogida"
      },
      "health": {
        "titulo": "Health",
        "descripcion": "Health check del modulo pedidos."
      }
    },
    "datos": {
      "op": "list",
      "titulo": "List",
      "refresh_on": [
        "pedido.creado",
        "pedido.item_agregado",
        "pedido.item_actualizado",
        "pedido.item_eliminado",
        "pedido.enviado_cocina",
        "pedido.completado",
        "pedido.cancelado"
      ]
    },
    "estados": [
      {
        "nombre": "borrador",
        "terminal": false,
        "color": "gray",
        "icono": "📝"
      },
      {
        "nombre": "creado",
        "terminal": false,
        "color": "blue",
        "icono": "🆕"
      },
      {
        "nombre": "enviado_cocina",
        "terminal": false,
        "color": "orange",
        "icono": "🔥"
      },
      {
        "nombre": "completado",
        "terminal": true,
        "color": "green",
        "icono": "✔️"
      },
      {
        "nombre": "cancelado",
        "terminal": true,
        "color": "red",
        "icono": "❌"
      }
    ],
    "flujo": [
      {
        "nombre": "consulta",
        "orden": 1,
        "ops": [
          "list",
          "get"
        ],
        "descripcion": "Ver y buscar"
      },
      {
        "nombre": "transicion",
        "orden": 4,
        "ops": [
          "complete",
          "cancel",
          "confirmar-recogida"
        ],
        "descripcion": "Cambiar estado"
      },
      {
        "nombre": "utilidad",
        "orden": 5,
        "ops": [
          "total",
          "health"
        ],
        "descripcion": "Herramientas"
      }
    ],
    "dependencias": {
      "get": [
        {
          "campo": "id",
          "de": "list"
        }
      ],
      "complete": [
        {
          "campo": "pedido_id",
          "de": "list"
        }
      ],
      "cancel": [
        {
          "campo": "pedido_id",
          "de": "list"
        }
      ],
      "total": [
        {
          "campo": "pedido_id",
          "de": "list"
        }
      ]
    },
    "guardas": {
      "add-item": {
        "sensible_estado": true
      },
      "update-item": {
        "sensible_estado": true
      },
      "delete-item": {
        "sensible_estado": true
      },
      "send-kitchen": {
        "sensible_estado": true
      },
      "complete": {
        "sensible_estado": true
      },
      "cancel": {
        "sensible_estado": true
      },
      "crear-tienda": {
        "sensible_estado": true
      }
    },
    "detalle": {
      "op": "get",
      "titulo": "Detalle de pedido",
      "cabecera": [
        "id",
        "estado",
        "created_at"
      ],
      "campo_items": "items",
      "campo_total": "total",
      "estados": [
        "borrador",
        "creado",
        "enviado_cocina",
        "completado",
        "cancelado"
      ],
      "acciones_contextuales": [
        "complete",
        "cancel",
        "confirmar-recogida"
      ]
    }
  }
}
