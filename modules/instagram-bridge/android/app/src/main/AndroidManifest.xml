<?xml version="1.0" encoding="utf-8"?>
<!--
  El manifiesto del puente. Tres decisiones que no son de estilo:

  1. `usesCleartextTraffic="false"`: el canal va por `wss://` (el crate rechaza
     cualquier otra cosa con `url_no_segura`). Permitir HTTP en claro aqui seria
     dar permiso a un canal que el crate no abre, y dejar la puerta abierta para
     el dia que alguien pruebe con `ws://`.

  2. `RECEIVE_BOOT_COMPLETED` esta declarado pero NO hay receptor. Desde el bloque
     19e la llave SI esta en el aparato, pero cifrada en el llavero (`Credenciales.kt`),
     no en un fichero: la razon para no arrancar en el boot ya no es "no hay llave",
     es que Android 12+ restringe el arranque de servicios en primer plano desde
     BOOT_COMPLETED y un arranque a medias (servicio arriba, canal sin red) es peor
     que uno que el dueño pide. Lo que SI se cubre es la muerte del proceso
     (`START_STICKY` en `ServicioEnki`), que es el caso de MIUI matandolo al abrir
     Instagram.

  3. El servicio de accesibilidad es `exported="true"` con
     `BIND_ACCESSIBILITY_SERVICE`: no es una fuga, es el contrato de Android. Solo
     el sistema (que tiene ese permiso) puede engancharlo. Sin esa combinacion el
     servicio no aparece en Ajustes > Accesibilidad.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- El canal vive en un servicio en primer plano: sin esto el sistema lo mata
         en cuanto la pantalla se apaga, que es justo cuando tiene que seguir. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- La notificacion persistente del servicio (obligatoria desde API 26 y
         visible solo con este permiso desde API 33). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Declarado para el dia que exista credencial persistente (ver nota 2). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Desde API 30 `resolveActivity` no ve Instagram aunque este instalado si no
         se declara aqui. Sin esto, compartir falla con `sin_actividad_para_compartir`
         y parece que la app no esta. -->
    <queries>
        <package android:name="com.instagram.android" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_notificacion"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.InstagramBridge"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A1/A3: el arbol y los gestos. El XML de configuracion es
             @xml/accesibilidad (existe: res/xml/accesibilidad.xml). -->
        <service
            android:name=".Accesibilidad"
            android:exported="true"
            android:label="@string/servicio_accesibilidad_nombre"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accesibilidad" />
        </service>

        <!-- El canal: mantiene vivo el hilo del crate. `specialUse` es el tipo que
             Android exige a un servicio en primer plano que no es musica, ubicacion
             ni llamada; el subtipo se declara para que la revision de Play sepa
             que hace. -->
        <service
            android:name=".ServicioEnki"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="puente_de_operacion_de_instagram" />
        </service>

        <!-- Compartir.kt entrega ficheros a la app de Instagram por FileProvider:
             sin este provider, `FileProvider.getUriForFile` lanza y el share sheet
             no abre. La autoridad tiene que ser la MISMA constante que
             `Compartir.AUTORIDAD_FICHEROS`. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="online.enki.instagram.ficheros"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_ficheros" />
        </provider>
    </application>

</manifest>
