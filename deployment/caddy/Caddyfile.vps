# Event Core - Caddyfile para VPS con dominio pizzepos.es
#
# Caddy obtiene certificados HTTPS automáticamente via Let's Encrypt.
# Event-core corre en localhost:3000, frontend SvelteKit en localhost:3001.
#
# ── DOS SUPERFICIES ──────────────────────────────────────────────────────────
#
#   pizzepos.es        PÚBLICO. Solo cartas, pedidos y webhooks. Sin contraseña.
#                      Todo lo que no esté en la lista responde 404.
#
#   1.pizzepos.es      PRIVADO. El panel, el chat, el comandero y la cocina.
#                      Sin contraseña: se protege por aislamiento (otro origen)
#                      y por no estar enlazado ni indexado.
#
# El aislamiento es lo que arregla el problema de fondo: un 401 del panel ya no
# puede aparecer encima de una carta, porque son orígenes distintos. Y las
# cartas no comparten credenciales con nada.
#
# Usado por: deployment/vps-setup.sh (crea enki.service + enki-frontend.service)
#
# Instalación:
#   sudo cp Caddyfile.vps /etc/caddy/Caddyfile
#   sudo systemctl restart caddy
#
# Requisitos:
#   - DNS de pizzepos.es apuntando a la IP del VPS
#   - Puertos 80 y 443 abiertos (firewall)
#   - enki.service corriendo en localhost:3000 (node index.js)
#   - enki-frontend.service corriendo en localhost:3001 (node frontend/build/index.js)

pizzepos.es {
	# ── PÚBLICO ──────────────────────────────────────────────────────────────
	# Nada de aquí pide contraseña. Es deliberado: un 401 abre el diálogo del
	# navegador ENCIMA de la página que estés viendo, aunque la página sea
	# pública. Por eso lo privado no vive aquí: vive en 1.<dominio>.

	handle /health {
		reverse_proxy localhost:3000
	}

	# Canal TELEGRAM de pedidos — el borrador que pide la carta. Mismo patrón que
	# `/tienda/*` → tienda-api: ruta pública limpia, el bundle no filtra el nombre
	# del módulo interno. Va ANTES por legibilidad; Caddy resuelve `handle` por
	# especificidad de path, así que `/tienda/telegram/*` gana a `/tienda/*` sin
	# depender del orden.
	#   carta → POST /tienda/telegram/borrador/<project>  (items por id, sin precios)
	#         → /modules/pedido-telegram/tienda/telegram/borrador/<project>
	#   → { codigo, url: t.me/<bot>?start=p_<codigo> } → el cliente pulsa /start
	#   → el servidor RE-TASA contra la carta y emite pedido.crear-tienda.
	handle /tienda/telegram/* {
		rewrite * /modules/pedido-telegram{path}
		reverse_proxy localhost:3000
	}

	# Vertical vapers — endpoint público de la PWA para enviar pedidos.
	# Rewrite a `/modules/tienda-api/tienda/pedido/<project>` (path interno con
	# prefix del module HTTP gateway). Razón de mantener `/tienda/*` público
	# limpio en lugar de incluir el prefix en el static-template:
	#   - La URL pública de pedido no debería filtrar el nombre del módulo
	#     interno (acoplamiento).
	#   - Permite renombrar `tienda-api` sin regenerar bundles.
	#   - El static-template del builder mantiene `/tienda/pedido/<slug>` como
	#     contrato público del canal.
	handle /tienda/* {
		rewrite * /modules/tienda-api{path}
		reverse_proxy localhost:3000
	}

	# Glovo — webhook de pedidos (Partner API, order dispatch).
	# Ruta pública limpia que reescribe al módulo interno cuentas-canales,
	# mismo patrón que `/tienda/*` → tienda-api (no filtra el nombre del módulo).
	#   Glovo registra: https://pizzepos.es/glovo/webhook/<project>
	#   → reescribe a /modules/cuentas-canales/glovo/webhook/<project> (localhost:3000)
	# El handler valida el token estático (cabecera) antes de procesar.
	handle /glovo/* {
		rewrite * /modules/cuentas-canales{path}
		reverse_proxy localhost:3000
	}

	# WhatsApp — webhook de Meta Cloud API (servicio estándar multi-proyecto).
	# Ruta pública limpia que reescribe al módulo interno whatsapp-bot, mismo
	# patrón que `/tienda/*` → tienda-api y `/glovo/*` → cuentas-canales
	# (no filtra el nombre del módulo interno; deja renombrar el módulo y
	# mantiene el contrato público del canal estable).
	#   Meta Cloud registra: https://pizzepos.es/whatsapp/webhook/<project>
	#   → reescribe a /modules/whatsapp-bot/whatsapp/webhook/<project> (localhost:3000)
	# Verificación (hub.verify_token) y mensajes entrantes, por proyecto.
	handle /whatsapp/* {
		rewrite * /modules/whatsapp-bot{path}
		reverse_proxy localhost:3000
	}

	# OpenSCAD MCP — servidor remoto de diseño 3D (path /scad/* en el dominio
	# principal, sin subdominio). Auth por token Bearer compartido (ENKI_MCP_TOKEN).
	# El endpoint MCP del contenedor es /mcp; el rewrite quita el prefijo /scad.
	handle /scad/* {
		@no_token {
			not header Authorization "Bearer {env.ENKI_MCP_TOKEN}"
		}
		respond @no_token 401
		rewrite * /mcp
		reverse_proxy localhost:3100
	}

	# El BUS se queda aquí porque la cocina (ESP32) entra por wss en 443.
	# Su llave viaja en la URL (?k=...). Lo escribe deployment/llave-mqtt.sh en
	# un snippet aparte que el deploy no pisa. Sin llave responde 404, NO 401:
	# un 401 abriría el diálogo de contraseña en cualquier navegador.
	import /etc/caddy/puerta.caddy

	# NAMESPACE PÚBLICO GLOBAL `/<public_ns>/` (por defecto /a/). UN solo bloque
	# sirve TODAS las superficies de TODOS los proyectos: cada superficie (shop,
	# oraculo, …) es una subcarpeta de /opt/enki/public/<ns>/, y cada proyecto un
	# symlink dentro (lo crea project-manager al activar su feature). AÑADIR una
	# superficie o un proyecto = soltar la carpeta/symlink; este Caddyfile NO se
	# toca. El prefijo se cambia en UN sitio: config.json `web.public_ns`.
	#
	# El bloque de abajo lo GENERA el reconciliador (deployment/reconcile.js) con
	# el valor de public_ns, sustituyendo este marcador.
	#
	# Convención URL → filesystem (ns='a'):
	#   GET /a/shop/vapers/     → /opt/enki/public/a/shop/vapers/index.html
	#   GET /a/oraculo/vapers/  → /opt/enki/public/a/oraculo/vapers/index.html
	#
	# `/<ns>/` es un namespace reservado: no colisiona con /modules, /ui, /tienda,
	# /glovo ni el frontend.
	# @@NAMESPACE@@

	# TODO LO DEMÁS NO EXISTE EN EL DOMINIO PÚBLICO.
	# Aquí vivían /ui/*, /modules/*, /stats y el frontend (panel, chat, comandero,
	# cocina). Ahora están en 1.<dominio>. Un 404 no revela nada y no abre ningún
	# diálogo; un 401 sí.
	handle {
		respond 404
	}

	# Headers de seguridad
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Logs
	log {
		output file /var/log/caddy/pizzepos.log
		format json
	}
}

# Hermes Agent — dashboard web (hermes.<domain>)
# Usa: hermes dashboard (localhost:9119)
hermes.pizzepos.es {
	# El dashboard de Hermes solo acepta Host/Origin = 127.0.0.1:9119.
	# El navegador envía Host=hermes.<domain> y Origin=https://hermes.<domain>,
	# así que Caddy los reescribe antes de reenviar.
	reverse_proxy localhost:9119 {
		header_up Host 127.0.0.1:9119
		header_up Origin 127.0.0.1:9119
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output file /var/log/caddy/hermes.pizzepos.log
		format json
	}
}

# ── PRIVADO: 1.<dominio> ──────────────────────────────────────────────────────
# El panel, el chat, el comandero, la cocina y la configuración de proyectos.
# Las rutas llevan SIEMPRE el slug del proyecto: /<slug>/chat, /<slug>/comandero,
# /<slug>/cocina. El layout del frontend resuelve slug → UUID y normaliza la URL
# al slug (frontend/src/routes/[project_id]/+layout.svelte).
#
# SIN CONTRASEÑA, por decisión del dueño. Lo que protege es:
#   · ser otro origen (su 401 no puede salir en una carta)
#   · no estar enlazado desde ningún sitio
#   · no indexarse (X-Robots-Tag + robots.txt)
#
# LAS RUTAS DEL CORE SE PROXean AQUÍ. Si el panel vive en este subdominio y llama
# a /ui/* o /mqtt en el dominio principal, esas llamadas pasan a ser cross-origin:
# el navegador rechaza la cookie y el websocket valida el Origin. Proxyando aquí,
# el navegador no sale nunca de 1.<dominio> y no hay CORS que configurar.
1.pizzepos.es {
	header {
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Los buscadores no tienen nada que rastrear aquí.
	respond /robots.txt "User-agent: *\nDisallow: /\n" 200

	# El panel habla con el core: mismo origen, sin CORS.
	handle /ui/* {
		reverse_proxy localhost:3000
	}
	handle /modules/* {
		reverse_proxy localhost:3000
	}
	handle /stats {
		reverse_proxy localhost:3000
	}
	handle /health {
		reverse_proxy localhost:3000
	}

	# MQTT WebSocket (panel y cocina).
	handle /mqtt {
		reverse_proxy localhost:9001
	}

	# Imágenes y vídeos de proyecto, bajo el mismo origen que el panel.
	handle_path /a/* {
		root * /opt/enki/public/a
		try_files {path} {path}/index.html /index.html
		file_server
	}

	# El resto: el frontend SvelteKit. Aquí entran /<slug>/chat, /<slug>/comandero,
	# /<slug>/cocina y todas las páginas de proyecto.
	handle {
		reverse_proxy localhost:3001
	}

	log {
		output file /var/log/caddy/1.pizzepos.log
		format json
	}
}
