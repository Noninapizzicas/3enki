<?xml version="1.0" encoding="utf-8"?>
<resources>

    <string name="app_name">Puente Enki</string>

    <!-- Servicio de accesibilidad: el nombre y la descripcion son lo unico que el
         dueño lee antes de dar el permiso mas invasivo del sistema. Se dice lo que
         hace y lo que NO hace, sin adornos. -->
    <string name="servicio_accesibilidad_nombre">Puente Enki · Instagram</string>
    <string name="servicio_accesibilidad_descripcion">Lee el arbol de pantalla de Instagram y entrega los toques que le pide el puente de Enki. Solo mira la app de Instagram (com.instagram.android), no otras apps, y no envia nada a ningun sitio por su cuenta: el canal lo abre el servicio en primer plano con la llave del bus.</string>

    <!-- Pantalla principal -->
    <string name="campo_url_hint">URL del bus (wss://…)</string>
    <string name="campo_llave_hint">Llave del bus</string>
    <string name="boton_conectar">Conectar</string>
    <string name="boton_desconectar">Desconectar</string>
    <string name="boton_accesibilidad">Abrir ajustes de accesibilidad</string>
    <string name="boton_observar">OBSERVAR PANTALLA</string>
    <string name="boton_copiar">COPIAR VOLCADO</string>

    <string name="estado_canal">Canal: %1$s</string>
    <string name="canal_detenido">detenido</string>
    <string name="accesibilidad_activa">Servicio de accesibilidad: ACTIVO</string>
    <string name="accesibilidad_inactiva">Servicio de accesibilidad: APAGADO</string>
    <string name="biblioteca_presente">Libreria nativa: cargada (enki_instagram_bridge)</string>
    <string name="biblioteca_ausente">Libreria nativa: NO cargada. El APK se construyo sin jniLibs (compilacion del crate pendiente).</string>

    <string name="nota_inicial">La llave no se guarda en el aparato: se teclea en cada arranque y vive solo en memoria mientras el servicio esta vivo.</string>
    <string name="aviso_llave_no_se_guarda">Canal arrancando. La llave no se guarda en disco; si cierras la app, hay que volver a teclearla.</string>

    <string name="error_url_insegura">La URL tiene que empezar por wss://. El crate no abre un canal sin TLS, asi que un ws:// solo daria un error mas tarde y peor.</string>
    <string name="error_sin_llave">Falta la llave del bus.</string>
    <string name="error_sin_ajustes">Este aparato no tiene pantalla de ajustes de accesibilidad.</string>

    <!-- Volcado de pantalla (bloque 19b). Se dice lo que ha pasado con el numero
         de nodos delante: "enviado" sin cifra no distingue un arbol vacio de uno
         truncado, y las dos cosas cambian la receta. -->
    <string name="observar_sin_accesibilidad">activa el servicio primero</string>
    <string name="observar_leyendo">Leyendo la pantalla…</string>
    <string name="observar_enviado">volcado enviado: %1$d nodos</string>
    <string name="observar_enviado_truncado">volcado enviado: %1$d nodos (truncado: se corto el arbol en el tope)</string>
    <string name="observar_no_enviado">volcado NO enviado (%1$s). Usa COPIAR VOLCADO y pegalo en Telegram.</string>
    <string name="observar_sin_leer">no se pudo leer la pantalla: %1$s</string>
    <string name="volcado_copiado">volcado copiado al portapapeles (%1$d nodos)</string>
    <string name="volcado_nada">todavia no hay volcado: pulsa OBSERVAR PANTALLA primero</string>

