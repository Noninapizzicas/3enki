{
  "_doc": "Custodio single-writer del banco de nichos: candidatos, fichas, veredictos e histórico. Aplica la máquina de estados (CRUDO→…→PUBLICADO), el tope 100 con rotación (M6), el aparcado por falta de evidencia (M10) y la corrección de ficha del dueño (M10: EN_OBSERVACION→EN_EVALUACION, re-evaluación). NO decide: evalúa quien evalúa, decide el dueño (M11).",
  "config": {
    "persistence": {
      "concurrency": "single-writer",
      "data_path": "banco",
      "pattern": "single-json-file",
      "scope": "project"
    }
  },
  "dependencies": [],
  "description": "Custodio del banco de nichos del radar.",
  "language": "es",
  "main": "index.js",
  "name": "banco",
  "publishes": [
    {
      "event": "banco.candidato_anadido"
    },
    {
      "event": "banco.candidato_aparcado"
    },
    {
      "event": "banco.candidato_seleccionado"
    },
    {
      "event": "banco.candidato_publicado"
    },
    {
      "event": "banco.candidato_rotado"
    },
    {
      "event": "banco.candidato_ficha_corregida"
    },
    {
      "event": "banco.anadir.failed"
    },
    {
      "event": "banco.seleccionar.failed"
    }
  ],
  "subscribes": [
    {
      "event": "banco.anadir.request",
      "handler": "onAnadirRequest"
    },
    {
      "event": "banco.obtener.request",
      "handler": "onObtenerRequest"
    },
    {
      "event": "banco.listar.request",
      "handler": "onListarRequest"
    },
    {
      "event": "banco.aparcar.request",
      "handler": "onAparcarRequest"
    },
    {
      "event": "banco.seleccionar.request",
      "handler": "onSeleccionarRequest"
    },
    {
      "event": "banco.publicar.request",
      "handler": "onPublicarRequest"
    },
    {
      "event": "banco.corregir_ficha.request",
      "handler": "onCorregirFichaRequest"
    },
    {
      "event": "evaluador.veredicto_emitido",
      "handler": "onVeredictoEmitido"
    },
    {
      "event": "interfaz.veredicto_confirmado",
      "handler": "onVeredictoConfirmado"
    },
    {
      "event": "project.activated",
      "handler": "onProjectActivated"
    }
  ],
  "tools": [],
  "version": "0.2.0"
}
