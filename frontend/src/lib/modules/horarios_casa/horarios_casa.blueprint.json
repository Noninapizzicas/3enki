{
  "schema": "blueprint-interfaz-v2",
  "id": "horarios_casa",
  "version": "blueprint-2.0.0",
  "moduleId": "horarios_casa",
  "titulo": "Ventanas de impresión por persona en casa (4 perfiles), para la decisión de presencia del orquestador.",
  "eventos_que_escucho": [
    "horarios_casa.configurar_horario.request",
    "horarios_casa.obtener_horario.request",
    "horarios_casa.listar_horarios.request",
    "horarios_casa.ventana_activa.request",
    "project.activated"
  ],
  "transporte": {
    "rpc": [
      "horarios_casa.configurar_horario.request -> .response",
      "horarios_casa.obtener_horario.request -> .response",
      "horarios_casa.listar_horarios.request -> .response",
      "horarios_casa.ventana_activa.request -> .response"
    ]
  },
  "ui": {
    "ops": {
      "configurar_horario": {
        "titulo": "Configurar Horario",
        "args": [
          {
            "nombre": "persona_id",
            "tipo": "select",
            "required": true,
            "enum": [
              "papa",
              "mama",
              "hijo1",
              "hijo2"
            ],
            "descripcion": "Persona"
          },
          {
            "nombre": "ventanas",
            "tipo": "json",
            "required": true,
            "descripcion": "Ventanas: [{ dias:[\"LUN\",\"MAR\"], desde:\"09:00\", hasta:\"14:00\" }]"
          }
        ]
      },
      "obtener_horario": {
        "titulo": "Obtener Horario",
        "args": [
          {
            "nombre": "persona_id",
            "tipo": "select",
            "required": true,
            "enum": [
              "papa",
              "mama",
              "hijo1",
              "hijo2"
            ],
            "descripcion": "Persona"
          }
        ]
      },
      "listar_horarios": {
        "titulo": "Listar Horarios"
      },
      "ventana_activa": {
        "titulo": "Ventana Activa",
        "args": [
          {
            "nombre": "persona_id",
            "tipo": "select",
            "required": true,
            "enum": [
              "papa",
              "mama",
              "hijo1",
              "hijo2"
            ],
            "descripcion": "Persona"
          },
          {
            "nombre": "ahora",
            "tipo": "string",
            "required": false,
            "descripcion": "Instante ISO (opcional, usa el reloj real)"
          }
        ]
      }
    },
    "datos": {
      "op": "obtener_horario",
      "titulo": "Obtener Horario"
    },
    "flujo": [
      {
        "nombre": "jefe",
        "orden": 0,
        "ops": [
          "configurar_horario"
        ],
        "descripcion": "Configurar y consultar ventanas de impresión"
      },
      {
        "nombre": "utilidad",
        "orden": 5,
        "ops": [
          "obtener_horario",
          "listar_horarios",
          "ventana_activa"
        ],
        "descripcion": "Herramientas y consultas"
      }
    ],
    "roles": {
      "configurar_horario": "jefe",
      "obtener_horario": "neutro",
      "listar_horarios": "neutro",
      "ventana_activa": "utilizacion"
    }
  }
}
