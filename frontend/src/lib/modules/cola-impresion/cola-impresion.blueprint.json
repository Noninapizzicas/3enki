{
  "schema": "blueprint-interfaz-v2",
  "id": "cola-impresion",
  "version": "blueprint-2.1.0",
  "moduleId": "cola-impresion",
  "actor": "jefe",
  "_lente_roles": {
    "agente": "crear-blueprint-jefe v2",
    "metodo": "esquematizador-jefe",
    "arbitro": "futuro→jefe · ahora→utilizacion · solo-lee→neutro",
    "consolidacion": "modules/cola-impresion/esquema-jefe/pasada-1-jefe-cola-impresion.md",
    "dualidad": "JEFE=declara qué entra y en qué orden (entrar/reordenar) · UTILIZACION=operador extrae al imprimir (siguiente) · neutro=longitud/estado",
    "senales_pareadas": {
      "entrar": "cola.entrada",
      "reordenar": "cola.reordenada",
      "siguiente": "cola.extraccion"
    }
  },
  "titulo": "Cola de impresion 3D (CUSTODIO): ordena lo aprobado con un motor de ordenacion por variables (material, urgencia, tamano, tiempo) que se ajusta con el uso. Single-writer de su store por proyecto via PosPersistencia. La cola NUNCA decide que imprimir (invariante 6): solo ordena lo aprobado.",
  "eventos_publicados": [
    "cola.entrada",
    "cola.extraccion",
    "cola.reordenada",
    "cola.vacia",
    "cola.entrar.failed"
  ],
  "eventos_que_escucho": [
    "cola.entrar.request",
    "cola.siguiente.request",
    "cola.reordenar.request",
    "cola.longitud.request",
    "project.activated"
  ],
  "transporte": {
    "rpc": [
      "cola.entrar.request -> .response",
      "cola.siguiente.request -> .response",
      "cola.reordenar.request -> .response",
      "cola.longitud.request -> .response"
    ],
    "salida": [
      "cola.entrada",
      "cola.extraccion",
      "cola.reordenada",
      "cola.vacia",
      "cola.entrar.failed"
    ]
  },
  "ui": {
    "ops": {
      "entrar": {
        "titulo": "Encolar pieza",
        "descripcion": "Mete una pieza aprobada en la cola. Valida que el modelo existe en el catalogo (RPC best-effort) y que no este duplicado (409 ALREADY_EXISTS). Emite cola.entrada o cola.entrar.failed.",
        "args": [
          {
            "nombre": "modelo_id",
            "tipo": "ref",
            "required": true,
            "descripcion": "Identificador del modelo en el catalogo.",
            "ref": "catalogo-modelos.listar",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un modelo"
          },
          {
            "nombre": "nombre",
            "tipo": "string",
            "required": true,
            "descripcion": "Nombre de la pieza."
          },
          {
            "nombre": "material",
            "tipo": "string",
            "required": false,
            "descripcion": "Material de la pieza (default 'desconocido'). Coincidir con el material cargado gana prioridad en el motor."
          },
          {
            "nombre": "urgencia",
            "tipo": "number",
            "required": false,
            "descripcion": "Prioridad declarada por el dueno (1..5, default 1)."
          },
          {
            "nombre": "tamano",
            "tipo": "number",
            "required": false,
            "descripcion": "Tamano estimado en mm3 (0 = desconocido). Piezas pequenas primero."
          }
        ]
      },
      "siguiente": {
        "titulo": "Siguiente a imprimir",
        "descripcion": "Extrae la siguiente pieza segun el motor de ordenacion (material, urgencia, tamano, tiempo). El material de la pieza extraida pasa a ser el cargado. Emite cola.extraccion o cola.vacia.",
        "args": []
      },
      "reordenar": {
        "titulo": "Reordenar cola",
        "descripcion": "Sube/baja una pieza pendiente a una posicion (1-based). Solo opera sobre piezas en estado 'pendiente' (409 CONFLICT_STATE si no). Emite cola.reordenada.",
        "args": [
          {
            "nombre": "item_id",
            "tipo": "string",
            "required": true,
            "descripcion": "Identificador de la pieza pendiente a reordenar."
          },
          {
            "nombre": "pos",
            "tipo": "number",
            "required": true,
            "descripcion": "Posicion destino (1-based, se clampa al rango de pendientes)."
          }
        ]
      },
      "longitud": {
        "titulo": "Estado de la cola",
        "descripcion": "Longitud de la cola: pendientes + total. Alimenta la cinta-estado del panel del jefe.",
        "args": []
      }
    },
    "datos": {
      "op": "longitud",
      "titulo": "Estado de la cola",
      "refresh_on": [
        "cola.entrada",
        "cola.extraccion",
        "cola.reordenada",
        "cola.vacia",
        "cola.entrar.failed"
      ]
    },
    "estados": [
      {
        "nombre": "pendiente",
        "terminal": false,
        "color": "blue",
        "icono": "🕐"
      },
      {
        "nombre": "imprimiendo",
        "terminal": false,
        "color": "orange",
        "icono": "🔥"
      },
      {
        "nombre": "hecho",
        "terminal": true,
        "color": "green",
        "icono": "✔️"
      },
      {
        "nombre": "retirada",
        "terminal": true,
        "color": "gray",
        "icono": "📦"
      }
    ],
    "flujo": [
      {
        "nombre": "jefe",
        "orden": 1,
        "ops": [
          "entrar",
          "reordenar"
        ],
        "descripcion": "Declara y gobierna la cola (encolar piezas aprobadas y reordenar la prioridad)"
      },
      {
        "nombre": "utilizacion",
        "orden": 2,
        "ops": [
          "siguiente"
        ],
        "descripcion": "Opera al imprimir (el operador extrae la siguiente pieza segun el motor)"
      },
      {
        "nombre": "consulta",
        "orden": 3,
        "ops": [
          "longitud"
        ],
        "descripcion": "Ver estado de la cola (pendientes + total)"
      }
    ],
    "dependencias": {
      "entrar": [
        {
          "campo": "modelo_id",
          "de": "catalogo-modelos.listar"
        }
      ],
      "reordenar": [
        {
          "campo": "item_id",
          "de": "longitud"
        }
      ]
    },
    "guardas": {
      "entrar": {
        "sensible_estado": true
      },
      "reordenar": {
        "sensible_estado": true
      }
    },
    "detalle": {
      "op": "longitud",
      "titulo": "Estado de la cola",
      "cabecera": [
        "pendientes",
        "total"
      ],
      "campo_items": "pendientes",
      "campo_total": "total",
      "estados": [
        "pendiente",
        "imprimiendo",
        "hecho",
        "retirada"
      ],
      "acciones_contextuales": [
        "entrar",
        "reordenar"
      ]
    },
    "roles": {
      "entrar": "jefe",
      "reordenar": "jefe",
      "siguiente": "utilizacion",
      "longitud": "neutro"
    },
    "formas_jefe": {
      "entrar": "editor-bloque",
      "reordenar": "inline-gesture",
      "longitud": "cinta-estado"
    }
  }
}
