{
  "schema": "blueprint-interfaz-v2",
  "id": "variaciones",
  "version": "blueprint-2.0.0",
  "moduleId": "variaciones",
  "actor": "jefe",
  "titulo": "Gestion de variaciones de productos pizzepos (quitar/anadir ingredientes). Reglas por producto: que se puede quitar, que se puede anadir, maximo de extras. Se configura desde la CARTA (carta.actualizada/editada). Calcula precio final consultando precios al modulo ingredientes (fuente unica via uiHandler.handle('ingredientes', ...)). Auto-valida cada comandero.item_agregado y emite variacion.{validada,rechazada}.",
  "eventos_publicados": [
    "variacion.validada",
    "variacion.rechazada"
  ],
  "eventos_que_escucho": [
    "project.activated",
    "carta.actualizada",
    "carta.editada",
    "producto.creado",
    "comandero.item_agregado"
  ],
  "transporte": {
    "rpc": [
      "variaciones.get.request -> .response",
      "variaciones.validar.request -> .response",
      "variaciones.calcular_precio.request -> .response",
      "variaciones.health.request -> .response",
      "variaciones.metrics.request -> .response",
      "variaciones.evaluar.request -> .response"
    ],
    "salida": [
      "variacion.validada",
      "variacion.rechazada"
    ]
  },
  "ui": {
    "ops": {
      "get": {
        "titulo": "Get",
        "descripcion": "Obtiene la configuracion de variaciones de un producto: ingredientes que se pueden quitar, si permite anadir extras, sugerencias y maximo de extras.",
        "args": [
          {
            "nombre": "producto_id",
            "tipo": "ref",
            "required": true,
            "descripcion": "Identificador del producto.",
            "ref": "productos.carta_completa",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un producto"
          }
        ]
      },
      "validar": {
        "titulo": "Validar",
        "descripcion": "Valida una variacion concreta: comprueba que los ingredientes a quitar esten permitidos y que los extras respeten el limite del producto.",
        "args": [
          {
            "nombre": "producto_id",
            "tipo": "ref",
            "required": true,
            "descripcion": "Identificador del producto.",
            "ref": "productos.carta_completa",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un producto"
          },
          {
            "nombre": "ingredientes_quitar",
            "tipo": "json",
            "required": false,
            "descripcion": "IDs de ingredientes a quitar."
          },
          {
            "nombre": "ingredientes_anadir",
            "tipo": "json",
            "required": false,
            "descripcion": "Lista de extras (cada item con ingrediente_id y cantidad)."
          }
        ]
      },
      "calcular_precio": {
        "titulo": "Calcular Precio",
        "descripcion": "Calcula el precio total de un producto con variaciones (precio base + suma de extras consultados al modulo ingredientes).",
        "args": [
          {
            "nombre": "producto_id",
            "tipo": "ref",
            "required": true,
            "descripcion": "Identificador del producto.",
            "ref": "productos.carta_completa",
            "ref_label": "nombre",
            "ref_value": "id",
            "placeholder": "selecciona un producto"
          },
          {
            "nombre": "ingredientes_anadir",
            "tipo": "json",
            "required": false,
            "descripcion": "Lista de extras (ingrediente_id, cantidad)."
          }
        ]
      },
      "health": {
        "titulo": "Health",
        "descripcion": "Health check del modulo variaciones: estado del modulo, version y total de productos configurados."
      },
      "metrics": {
        "titulo": "Metrics",
        "descripcion": "Metricas operativas del modulo variaciones (counters de variaciones validadas/rechazadas y gauges)."
      },
      "evaluar": {
        "titulo": "Evaluar"
      }
    },
    "datos": {
      "op": "get",
      "titulo": "Get",
      "refresh_on": [
        "variacion.validada",
        "variacion.rechazada"
      ]
    },
    "estados": [
      {
        "nombre": "borrador",
        "terminal": false,
        "color": "gray",
        "icono": "📝"
      },
      {
        "nombre": "validada",
        "terminal": false,
        "color": "gray",
        "icono": "⚪"
      },
      {
        "nombre": "rechazada",
        "terminal": false,
        "color": "gray",
        "icono": "⚪"
      }
    ],
    "flujo": [
      {
        "nombre": "consulta",
        "orden": 1,
        "ops": [
          "get"
        ],
        "descripcion": "Ver y buscar"
      },
      {
        "nombre": "utilidad",
        "orden": 5,
        "ops": [
          "validar",
          "calcular_precio",
          "health",
          "metrics",
          "evaluar"
        ],
        "descripcion": "Herramientas"
      }
    ],
    "detalle": {
      "op": "get",
      "titulo": "Detalle de variacione",
      "cabecera": [
        "id",
        "estado",
        "created_at"
      ],
      "campo_items": "items",
      "campo_total": "total",
      "estados": [
        "borrador",
        "validada",
        "rechazada"
      ],
      "acciones_contextuales": [
        "validar",
        "calcular_precio",
        "metrics",
        "evaluar"
      ]
    }
  }
}
