# =====================================================================
# Cocina P4 — defaults de compilacion (GUITION JC8012P4A1C)
# Base: examples/esp-idf/08_lvgl_demo_v9 del repo Waveshare (estructura de
#       LVGL/PSRAM/MQTT, que es agnostica de placa) pero SIN nada del BSP
#       Waveshare: aqui el panel JD9365 y el GT911 se montan a mano.
# =====================================================================

# --- Target / revision de silicio -----------------------------------------
CONFIG_IDF_TARGET="esp32p4"
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
CONFIG_BOOTLOADER_LOG_LEVEL=1

# --- Flash / particiones --------------------------------------------------
# device.yaml de la JC8012P4A1 declara flash_size: 16MB. Si tu unidad trae
# 32 MB, sube esto a 32MB (sobra sitio; la tabla de particiones no cambia).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- PSRAM 32 MB + cache (valores del ejemplo oficial) --------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=y

# --- Sistema --------------------------------------------------------------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# --- Panel / tactil / puente LVGL (sin BSP: componentes sueltos) ---------
# esp_lcd_touch: 1 punto de contacto (en cocina se toca una tarjeta cada vez)
CONFIG_ESP_LCD_TOUCH_MAX_POINTS=1
CONFIG_ESP_LCD_TOUCH_MAX_BUTTONS=0

# --- LVGL 9 (lo arranca main.c con lvgl_port_init) ------------------------
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_USE_FLEX=y
CONFIG_LV_USE_GRID=y
CONFIG_LV_USE_SYSMON=y
# Tipografias de la UI: contenido 32 px, contador 48 px, resto 20/24/28.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_LOG=n

# --- MQTT + TLS (esp-mqtt, wss:// por 443) --------------------------------
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=y
CONFIG_MQTT_TASK_STACK_SIZE=6144
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=30000
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y

# --- WiFi por coprocesador ESP32-C6 (esp_hosted, SDIO) --------------------
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
